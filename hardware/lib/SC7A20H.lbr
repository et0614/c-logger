<devicesets>
<deviceset name="SC7A20H" prefix="U">
<description>Silan SC7A20H 3軸加速度計 (±2/4/8/16 g、12 bit、1.71〜3.6 V)。
I2C で使うとき: CS (10番) は内部で VDDIO にプルアップされているので未接続でよい。SDO (1番) は未接続か High でアドレス 0x19、Low で 0x18 (Low にすると内部プルアップに電流が流れるので、未接続を勧める)。RES は SC7A20H のデータシートの 4番 NC で、GND につなぐ (I2C/SPI のどちらでも GND)。11番 NC は未接続。
VDD と VDDIO にそれぞれ 100 nF。I2C のプルアップはデータシートの推奨 4.7 kΩ。INT1・INT2 は既定でプッシュプル、割り込みで High。
WHO_AM_I (0x0F) = 0x11。</description>
<gates>
<gate name="G$1" symbol="SC7A20H" x="0" y="0"/>
</gates>
<devices>
<device name="" package="LGA-12_2X2X1.0_SC7A20H">
<connects>
<connect gate="G$1" pin="SDO" pad="1"/>
<connect gate="G$1" pin="SDA" pad="2"/>
<connect gate="G$1" pin="VDDIO" pad="3"/>
<connect gate="G$1" pin="RES" pad="4"/>
<connect gate="G$1" pin="INT1" pad="5"/>
<connect gate="G$1" pin="INT2" pad="6"/>
<connect gate="G$1" pin="VDD" pad="7"/>
<connect gate="G$1" pin="GNDIO" pad="8"/>
<connect gate="G$1" pin="GND" pad="9"/>
<connect gate="G$1" pin="CS" pad="10"/>
<connect gate="G$1" pin="NC" pad="11"/>
<connect gate="G$1" pin="SCL" pad="12"/>
</connects>
<technologies>
<technology name="">
<attribute name="MPN" value="SC7A20HTR"/>
<attribute name="MANUFACTURER" value="Silan"/>
</technology>
</technologies>
</device>
</devices>
</deviceset>
